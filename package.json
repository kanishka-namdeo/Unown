{
  "name": "unown",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Unown \u2014 a self-improving coding agent built on the pi coding agent: tiered memory, hooks, AutoDreaming, a self-improving harness, sandbox testing, routing, and a mission-control dashboard.",
  "bin": {
    "unown": "bin/unown"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test:unit": "bun test src",
    "unown": "bun bin/unown",
    "agent:install": "bash scripts/install.sh",
    "agent:start": "bash scripts/start.sh",
    "agent:stop": "bash scripts/stop.sh",
    "agent:link": "bash scripts/link.sh",
    "agent:bridge": "cd mini-services/llm-bridge && bun --hot index.ts",
    "agent:engine": "cd mini-services/agent-service && bun --hot index.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@mdxeditor/editor": "4.3.3",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
