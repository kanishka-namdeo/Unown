{
  "name": "unown",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Unown — a self-improving coding agent built on the pi coding agent: tiered memory, hooks, AutoDreaming, a self-improving harness, sandbox testing, routing, and a mission-control dashboard.",
  "bin": {
    "unown": "bin/unown"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node -e \"const fs=require('fs'); fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true}); fs.cpSync('public','.next/standalone/public',{recursive:true})\"",
    "start": "bun scripts/serve-dashboard.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test src",
    "test:coverage": "node scripts/check_coverage.mjs --run",
    "check:docs": "node scripts/check_docs.mjs docs/*.md",
    "check:changelog": "node scripts/landing_changelog.mjs --check",
    "check:benchmarks": "node scripts/landing_benchmarks.mjs --check",
    "check:claims": "node scripts/landing_claims.mjs --check",
    "release:artifacts": "bun scripts/build-artifacts.ts",
    "test:artifacts": "node --test scripts/build-artifacts.test.mjs",
    "audit:landing": "node scripts/landing_audit.mjs",
    "review:vlm": "node scripts/agnes_review.mjs",
    "unown": "bun bin/unown",
    "agent:install": "bun scripts/install.ts",
    "agent:start": "bun scripts/start.ts",
    "agent:stop": "bun scripts/stop.ts",
    "agent:link": "bun scripts/link.ts",
    "agent:bridge": "cd mini-services/llm-bridge && bun --hot index.ts",
    "agent:engine": "cd mini-services/agent-service && bun --hot index.ts",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@mdxeditor/editor": "4.3.3",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reactuses/core": "^6.5.9",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-table": "9.3.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "14.2.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.57.0",
    "next": "^16.4.1",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "prisma": "7.10.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-is": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.14.5",
    "react-syntax-highlighter": "16.1.2",
    "recharts": "3.10.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "14.0.3",
    "vaul": "^1.1.2",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@happy-dom/global-registrator": "^21.0.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "1.4.3",
    "eslint": "10.12.0",
    "eslint-config-next": "^16.4.1",
    "happy-dom": "^21.0.3",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.3"
}
