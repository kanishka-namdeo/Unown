{
  "name": "unown",
  "version": "0.0.61",
  "private": true,
  "type": "module",
  "description": "Unown — a self-improving coding agent built on the pi coding agent: tiered memory, hooks, AutoDreaming, a self-improving harness, sandbox testing, routing, and a terminal-first mission control (unown dashboard).",
  "bin": {
    "unown": "bin/unown"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node -e \"const fs=require('fs'); fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true}); fs.cpSync('public','.next/standalone/public',{recursive:true})\"",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test ./src --path-ignore-patterns=data/self-learning/**",
    "test:coverage": "node scripts/check_coverage.mjs --run",
    "check:docs": "node scripts/check_docs.mjs docs/*.md",
    "check:changelog": "node scripts/landing_changelog.mjs --check",
    "check:blog": "node scripts/landing_blog.mjs --check",
    "check:benchmarks": "node scripts/landing_benchmarks.mjs --check",
    "check:claims": "node scripts/landing_claims.mjs --check",
    "release:artifacts": "bun scripts/build-artifacts.ts",
    "test:artifacts": "node --test scripts/build-artifacts.test.mjs",
    "audit:landing": "node scripts/landing_audit.mjs",
    "review:vlm": "node scripts/agnes_review.mjs",
    "critic:design": "node scripts/design_critic.mjs",
    "coda:dev": "bun apps/coda/scripts/serve.mjs",
    "coda:test": "cd apps/coda && bun test",
    "coda:e2e": "bunx playwright test -c playwright.coda.config.ts",
    "ostinato:dev": "bun apps/ostinato/serve.mjs",
    "ostinato:test": "cd apps/ostinato && bun test",
    "ostinato:e2e": "bunx playwright test -c playwright.ostinato.config.ts",
    "chaconne:dev": "bun apps/chaconne/serve.mjs",
    "chaconne:test": "cd apps/chaconne && bun test",
    "chaconne:e2e": "bunx playwright test -c playwright.chaconne.config.ts",
    "fugue:dev": "bun apps/fugue/serve.mjs",
    "fugue:test": "cd apps/fugue && bun test",
    "fugue:e2e": "bunx playwright test -c playwright.fugue.config.ts",
    "legato:dev": "bun apps/legato/serve.mjs",
    "legato:test": "cd apps/legato && bun test",
    "legato:e2e": "LEGATO_E2E=1 bunx playwright test -c playwright.legato.config.ts",
    "bolero:test": "cd apps/bolero && bun test",
    "bolero:e2e": "cd apps/bolero && BOLERO_E2E=1 bun test e2e",
    "bolero:server": "cd apps/bolero && bun src/server/boot.ts",
    "bolero:verify-precache": "bun apps/bolero/scripts/verify-precache.ts",
    "unown": "bun bin/unown",
    "agent:install": "bun scripts/install.ts",
    "agent:start": "bun scripts/start.ts",
    "agent:stop": "bun scripts/stop.ts",
    "agent:link": "bun scripts/link.ts",
    "agent:bridge": "cd mini-services/llm-bridge && bun --hot index.ts",
    "agent:engine": "cd mini-services/agent-service && bun --hot index.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "clsx": "^2.1.1",
    "framer-motion": "14.9.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "1.66.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "1.4.4",
    "eslint": "10.14.0",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "marked": "^18.1.2",
    "playwright": "1.65.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
