# Unown — environment configuration (copy to .env and adjust).
# Every variable is optional; defaults are shown.

# ── Self-learning engine (agent-service) ────────────────────────────────────
# Port for the REST+SSE API the TUI dashboard and CLI clients talk to.
PI_AGENT_PORT=3030
# What interface the engine binds (127.0.0.1). Keep the loopback default:
# even WITH the M7 bearer token, 0.0.0.0 puts the learning surface (notes,
# memory, providers, automations) on the network — the token then gates it,
# but loopback is the safe default.
UNOWN_ENGINE_HOST=
# Engine API authentication (M7). "token" (default): the engine generates a
# per-boot bearer token in data/self-learning/engine.token (0600) and every
# /api request must present it — same-user clients (CLI, TUI, dashboard)
# auto-discover it, so the default costs nothing. "off": tokenless — REFUSED
# at boot when UNOWN_ENGINE_HOST leaves loopback (an unauthenticated network
# bind can never exist). Host-header validation + Origin enforcement are
# always on regardless of this setting.
UNOWN_ENGINE_AUTH=
# Pin the engine token instead of generating per-boot (engine side), or
# present a specific token as a CLIENT (when UNOWN_ENGINE_URL points at a
# remote engine whose token file you know).
UNOWN_ENGINE_TOKEN=
# Extra DNS hostnames accepted in the engine's Host header (comma-separated,
# Vite allowedHosts-style). Default: localhost, *.localhost and IP literals
# only — same-port DNS rebinding (evil.com resolving to 127.0.0.1) is refused.
UNOWN_ENGINE_HOSTS=
# Which browser origins may call the engine API (CORS). Default: loopback
# origins only (http://localhost:*/http://127.0.0.1:*, any port) — the engine
# is loopback-first; in-tree clients (TUI dashboard, CLI) are not browsers and
# never send Origin. Override:
# comma-separated origin list (replaces the default), "*" (any origin — only
# next to UNOWN_ENGINE_HOST + an authenticating reverse proxy), or "off".
UNOWN_ENGINE_CORS=
# Set to 1 by the engine's scheduler on every automation run (hides the
# automation mutation tools inside the unattended session). Never set it by
# hand — documented here so the knob is discoverable:
#   UNOWN_AUTOMATION=1
# Where the engine finds the OpenAI-compatible LLM endpoint.
PI_BRIDGE_URL=http://127.0.0.1:3031
# Model + provider names the engine registers with pi's models.json.
# Any model id works — the llm-bridge routes unknown ids onto its default.
PI_MODEL_ID=agnes-3.0-flash
PI_PROVIDER=zai-bridge
# Override the runtime data directory and SQLite database location.
# PI_SELFLEARNING_DATA=/absolute/path/to/data/self-learning
# PI_SELFLEARNING_DB=/absolute/path/to/selflearning.db

# ── LLM bridge (mini-services/llm-bridge) ───────────────────────────────────
# Port the bridge listens on.
BRIDGE_PORT=3031
# Model the bridge advertises / defaults to.
BRIDGE_MODEL=agnes-3.0-flash
# Upstream OpenAI-compatible endpoint the bridge proxies to (no trailing
# slash). Any OpenAI-compatible server works (Agnes AI, OpenAI, Dashscope,
# OpenRouter, vLLM, llama.cpp server, ...).
BRIDGE_UPSTREAM_URL=https://apihub.agnes-ai.com/v1
# Upstream bearer key - required for the bridge to reach its upstream.
BRIDGE_UPSTREAM_KEY=
# Model used when a request names an unknown / legacy model id. LEAVE EMPTY to
# follow BRIDGE_MODEL (recommended): a hard-coded id here silently overrides
# BRIDGE_MODEL and, when the upstream changes, routes unknown ids to a model
# the new upstream does not serve (upstream 404s with no local hint).
#BRIDGE_ROUTE_DEFAULT=agnes-3.0-flash
# Comma-separated allow-list of upstream model ids that pass through
# unrouted; anything else is mapped onto BRIDGE_ROUTE_DEFAULT.
BRIDGE_KNOWN_MODELS=agnes-3.0-flash,agnes-2.5-flash
# 1 = leave qwen thinking models in thinking mode (default: thinking is
#     disabled for snappy agent turns).
BRIDGE_QWEN_THINKING=
# Minimum spacing between upstream request STARTS, in ms (serialized throttle).
BRIDGE_MIN_SPACING_MS=400
# Cap on in-flight upstream attempts (headers-to-body-end), floor 1. The
# starvation fix: the upstream degrades badly under concurrent streams from
# one key (measured 2s -> 45s at 3-4 concurrent), so the bridge bounds
# concurrency and admits interactive (terminal/print) requests ahead of
# queued background work (engine learning jobs signal bearer
# "bridge-background" or the x-unown-lane header). 0/invalid = 3.
BRIDGE_MAX_CONCURRENCY=3
# Degenerate-completion guard (2026-10-23, always on — no knob): an upstream
# 200 with ZERO completion content (empty stream frames, or a JSON body with
# no content and 0 completion tokens; measured live under concurrent load)
# is retried ONCE transparently; a repeat is surfaced as an error (502
# non-stream) instead of a silent empty answer. /health's "degenerate"
# counter tracks them.
# Interactive-yield window, ms (45000; 0 disables): after any interactive
# request arrives, NEW background admissions pause for this long — a
# concurrency-sensitive upstream degrades every stream it shares, so while a
# human's terminal session is active the dream waits. Re-arms on each
# interactive arrival; already-admitted background streams finish uncanceled.
BRIDGE_BACKGROUND_YIELD_MS=45000

# Cap on time-to-response-headers per upstream attempt (ms). Bodies may stream
# longer once headers arrive. A stalled upstream fails fast instead of wedging.
BRIDGE_UPSTREAM_TIMEOUT_MS=180000
# Optional shared secret. When set, every request to the bridge must carry
#   Authorization: Bearer <BRIDGE_API_KEY>
# Recommended whenever the bridge is reachable beyond localhost.
BRIDGE_API_KEY=

# ── Terminal agent (`unown` CLI + project dreaming) ─────────────────────────
# State dir for the terminal agent: agent config, global memory, note outbox.
# Per-project memory lives in <project>/.unown/ instead.
UNOWN_HOME=
# Where the CLI delivers terminal session notes (and reads engine health).
UNOWN_ENGINE_URL=http://127.0.0.1:3030
# Print-mode answer ping (OSC-9 desktop notification + BEL fallback): when a
# `unown -p` answer lands after a long run (default 120000 ms) and stdout is
# a TTY, the terminal gets `unown: <first 80 chars of the answer>`. Text mode
# only — the TUI never pings (user present), and piped/JSON output never sees
# control bytes. 0/false/off/no disables; DO_NOT_TRACK=1 silences it too.
UNOWN_NOTIFY=
# How long a print run must last before its answer earns the ping (0 = every
# answer; unset/empty = the 120000 default).
UNOWN_NOTIFY_MS=
# ── Engine resilience (degraded mode — docs/resilience.md) ──────────────────
# The terminal agent always works with the engine down (chat unaffected,
# memory reads serve the last engine write, notes queue in the outbox);
# these tune what happens around the edges. All optional; defaults shown.
#   UNOWN_ENGINE_AUTOSTART=0     kill switch: never auto-spawn the engine
#                                from a session (manual `unown engine start`
#                                still works and resets the crash-loop circuit)
#   UNOWN_OUTBOX_MAX=200         queued-note cap while the engine is down
#                                (oldest dropped first; the dropped counter
#                                shows in /engine and `unown engine status`);
#                                0 = unlimited
#   UNOWN_NOTE_BUDGET_MS=2500    overall deadline for one note delivery
#                                attempt (floor 500) — on expiry the note
#                                lands in the outbox and the session proceeds
#   PI_ENGINE_PROBE_INTERVAL_MS=30000  engine-health probe cadence inside a
#                                session (floor 5000) — the footer line
#                                (memory: up | starting… | down | paused)
#                                follows it
#   PI_ENGINE_PROBE_TIMEOUT_MS=700     per-probe timeout (floor 100)
UNOWN_ENGINE_AUTOSTART=
UNOWN_OUTBOX_MAX=
UNOWN_NOTE_BUDGET_MS=
PI_ENGINE_PROBE_INTERVAL_MS=
PI_ENGINE_PROBE_TIMEOUT_MS=
# Update-path opt-outs (all optional; uncomment to activate — NO_UPDATE_NOTIFIER
# triggers on PRESENCE, so it is deliberately not shipped as an active empty key):
#   NO_UPDATE_NOTIFIER=1     any value (even empty) silences the startup update
#                            notice and its background check (ecosystem-standard
#                            name; manual `unown update` still works)
#   UNOWN_DISABLE_AUTOUPDATE=1  same as NO_UPDATE_NOTIFIER, Unown-native spelling
#   DO_NOT_TRACK=1           the standard nonessential-traffic opt-out;
#                            suppresses the background update check
#   UNOWN_DISABLE_UPDATES=1  blocks ALL update paths (unown update, --check,
#                            background check) — the org/CI kill switch
# 1 = sandbox-grade hooks in terminal sessions (blocks network, git push,
#     sudo); default 0 allows normal developer operations.
UNOWN_STRICT_HOOKS=
# Delegation policy for subagents (pi-cciotti port): never | rarely |
# standard | aggressive. Shapes the one-sentence delegation instruction in
# the system prompt's advertised-subagents block; "never" withdraws the
# catalog entirely (the task tool still works when invoked explicitly).
UNOWN_DELEGATION_LEVEL=
# Session-wide wall-clock budget for one SYNCHRONOUS subagent spawn
# (task tool), in ms. Human durations parse: 10m / 90s / 500ms. Values
# clamp to 30000..1800000 (30s..30min); junk falls back to the 300000
# default (5 min). A per-agent timeoutMs frontmatter field always wins —
# the browser builtin ships 600000 (10 min) because page flows are slow.
UNOWN_SUBAGENT_TIMEOUT_MS=
# 1 = skip the model-endpoint reachability check before each session
#     (print mode exits non-zero when the endpoint is down; see unown doctor).
UNOWN_NO_PREFLIGHT=
# Dream canary gate: re-run the last-passing benchmark task under a freshly
# dreamed project memory; roll the dream back if it fails. Set 0 to disable.
PI_DREAM_GATE=
# Canary sample size (K stratified samples — the most recent passing run per
# DISTINCT task). 0 disables sampling entirely (the dream ships on the guard
# alone — for fast low-stakes verification lanes). Default 3. Since the
# 2026-10-23 round a FAILED canary is re-run once (verify-twice): two
# failures gate, failure + pass is a flaky reference and the dream proceeds.
PI_DREAM_CANARY_K=
# Hard-won (harness/seed) memory rules are immune to the topic-section
# pruning caps but bounded by their own count (default 60, seeds first,
# then the newest harness fixes) — plus an absolute render ceiling at
# PI_MEMORY_MAX_TIER_CHARS with visible over-flow footers.
PI_MEM0_MAX_HARDWON=
# How long the engine's boot waits for the mem0 platform seed to settle
# before booting degraded (ms; floor 3s; default 30000). A slow-but-healthy
# upstream LLM round in the seed can legitimately exceed 30s — raise this
# instead of trusting a one-time "degraded" warning (the seed logs its
# late settlement when it does land).
PI_ENGINE_SEED_BUDGET_MS=

# ── Data retention (M9: the db-retention job keeps operational telemetry
#    bounded; precious tables — memory versions, skills, tasks, improvements,
#    automations — are NEVER pruned, and undreamed notes are the dream work
#    queue) ────────────────────────────────────────────────────────────────
# Global kill switch: 0 disables ALL pruning. A positive N overrides every
# per-table day window below (per-table knobs still win over N).
UNOWN_RETENTION_DAYS=
# hook_log: pruned past this window (days)…
UNOWN_RETENTION_HOOK_LOG_DAYS=
# …AND beyond this row cap (newest rows kept; 0 = no cap) — whichever
# triggers first (a busy engine must not grow without bound inside the window).
UNOWN_RETENTION_HOOK_LOG_MAX_ROWS=
# finished runs (with their ~19KB transcripts): 30 days.
UNOWN_RETENTION_RUNS_DAYS=
# dreams + ended cycles + finished automation_runs: 90 days (shared horizon).
UNOWN_RETENTION_HISTORY_DAYS=
# DREAMED notes only (undreamed notes are never pruned): 90 days.
UNOWN_RETENTION_NOTES_DAYS=
# Automations: skip (default) or catch-up-once after sleep/engine-down. 1 =
# a missed slot newer than 24h runs ONCE on wake (coalesced, rescheduled from
# now — launchd semantics); 0 = the cron-classic skip + record.
UNOWN_AUTOMATION_MISFIRE_CATCHUP=
# Misfire grace window in ms (default 300000): a due slot older than this is
# treated as missed-by-sleep rather than merely late.
PI_AUTOMATION_MISFIRE_GRACE_MS=


# ── Browser automation (the `browser` session tool — docs/browser.md) ────────
# The browser auto-starts on first use; every knob is optional.
# Explicit Chromium-family executable (default: system Chrome/Chromium/Edge
# per-OS paths, then the Playwright ms-playwright cache).
UNOWN_BROWSER_PATH=
# Attach to a running browser instead of launching one (ws:// endpoint,
# http://host:port, or bare host:port — /json/version discovery is done for
# you). The flagship use: your real Chrome started with
# --remote-debugging-port=9222, already logged in. Attach never kills it.
UNOWN_BROWSER_CDP=
# 0 runs headed — watch the agent work.
UNOWN_BROWSER_HEADLESS=
# Persistent profile directory (default ~/.unown/browser/profile — logins
# survive between runs; a locked profile falls back to a temp one).
UNOWN_BROWSER_PROFILE=
# Host-glob deny list, comma-separated (e.g. *.example.com,internal.corp),
# checked before every navigation. Localhost stays allowed by default.
UNOWN_BROWSER_BLOCK=
# Navigation timeout (ms).
UNOWN_BROWSER_TIMEOUT_MS=
# Post-action quiet settle (ms).
UNOWN_BROWSER_SETTLE_MS=
# Max elements per a11y snapshot before truncation.
UNOWN_BROWSER_SNAPSHOT_MAX=
# Max snapshot characters returned to the model.
UNOWN_BROWSER_SNAPSHOT_MAX_CHARS=
# ── Browser stealth tier (v2) ────────────────────────────────────────────────
# 1 = every browser session runs in stealth mode: the Runtime domain is never
# enabled (the CDP detection signal stays silent), the fingerprint is applied
# by the browser itself (no JS patching), input is humanized, and the stripped
# chrome-headless-shell binaries are excluded from discovery.
#UNOWN_BROWSER_STEALTH=
# Claimed OS identity: windows | macos | linux (each coherent end-to-end).
#UNOWN_BROWSER_OS=
# Explicit UA override (rest of the identity still applies).
#UNOWN_BROWSER_USER_AGENT=
#UNOWN_BROWSER_LOCALE=
# IANA id (validated; invalid ids fall back to the default).
#UNOWN_BROWSER_TIMEZONE=
# Claimed screen, WxH.
#UNOWN_BROWSER_SCREEN=
# 0 disables humanized mouse paths / per-character typing. A fixed seed makes
# the paths reproducible (what the tests pin).
#UNOWN_BROWSER_HUMANIZE=
#UNOWN_BROWSER_HUMANIZE_SEED=
# Proxy for site traffic (http://…, socks5://…, host:port); loopback bypassed.
#UNOWN_BROWSER_PROXY=

# ── Browser captcha tier (v2) ────────────────────────────────────────────────
# 2captcha | capsolver | none (default: whichever key below is set).
#UNOWN_CAPTCHA_SOLVER=
#UNOWN_CAPTCHA_2CAPTCHA_KEY=
#UNOWN_CAPTCHA_CAPSOLVER_KEY=
# 1 = auto-solve challenges detected right after navigate (detection is always
# on; this gates the paid/LLM tiers).
#UNOWN_CAPTCHA_AUTO=
# 0 disables the vision-OCR tier.
#UNOWN_CAPTCHA_VISION=
# Vision endpoint for image-captcha OCR (OpenAI-compatible; defaults to the
# Agnes preset below + AGNES_API_KEY).
#UNOWN_VISION_BASE_URL=
#UNOWN_VISION_API_KEY=
#UNOWN_VISION_MODEL=

# ── LSP code intelligence (terminal agent) ──────────────────────────────────
# 0 disables the lsp tool and the after-edit diagnostics feedback loop.
UNOWN_LSP=
# Max wait for fresh diagnostics after a write/edit, in ms (10000).
UNOWN_LSP_WAIT_MS=
# Per-request timeout for LSP JSON-RPC calls, in ms (15000).
UNOWN_LSP_TIMEOUT_MS=
# Cap on a single LSP message's Content-Length, in bytes (33554432 = 32 MiB);
# a violation recycles the connection instead of buffering it.
UNOWN_LSP_MAX_MSG_BYTES=
# After a language-server crash: cooldown before restart is attempted, in ms
# (30000; max 3 restarts per server per session).
UNOWN_LSP_CRASH_COOLDOWN_MS=
# Files larger than this skip LSP document sync, in bytes (4194304 = 4 MiB);
# logged once per file.
UNOWN_LSP_MAX_SYNC_BYTES=

# ── Auto-verify (the PostToolUse quality gate — aider-style, 2026-10) ────────
# After every write/edit of a non-doc file, run the project's OWN check
# command (package.json typecheck script, else lint; Makefile/pyproject
# fallbacks) and feed failures back into the tool result as an error — a
# broken edit is a FAILED edit. Silent on pass, cooldown-throttled,
# fail-open; the command passes the same bash-policy denylist the bash
# tool answers to. 0 disables the whole gate.
UNOWN_AUTO_VERIFY=
# Per-check timeout in ms (default 120000) and cooldown between runs in ms
# (default 20000; 0 = run on every eligible edit).
UNOWN_AUTO_VERIFY_TIMEOUT_MS=
UNOWN_AUTO_VERIFY_COOLDOWN_MS=
# 1 = also run the project's test command after edits (aider's --auto-test
# semantics; OFF by default — test suites can mutate state / hit the
# network). Own timeout (default 300000) and cooldown (default 60000).
UNOWN_AUTO_TEST=
UNOWN_AUTO_TEST_TIMEOUT_MS=
UNOWN_AUTO_TEST_COOLDOWN_MS=

# ── MCP client (terminal agent) ─────────────────────────────────────────────
# 0 disables the MCP client surface (no servers connect, no mcp__* tools).
UNOWN_MCP=
# Per-request timeout for MCP JSON-RPC calls, in ms (120000).
UNOWN_MCP_TIMEOUT_MS=
# Timeout for the MCP initialize handshake, in ms (20000).
UNOWN_MCP_CONNECT_TIMEOUT_MS=
# After an MCP server dies or fails to connect: cooldown before reconnect
# attempts resume, in ms (30000; /mcp force-throughs).
UNOWN_MCP_RECONNECT_COOLDOWN_MS=
# MCP keepalive ping interval, in ms (60000; a failed ping marks the server
# errored and starts the reconnect cooldown).
UNOWN_MCP_PING_INTERVAL_MS=

# ── Session checkpoints (terminal agent) ────────────────────────────────────
# Files larger than this are not checkpointed, in bytes (67108864 = 64 MiB);
# the turn still reverts its other files and the ledger notes the exception.
UNOWN_CHECKPOINT_MAX_BLOB_BYTES=

# ── Subagent worktree isolation (terminal agent) ────────────────────────────
# 0 disables the task tool's worktree-isolation lane: worktree_isolation
# spawns are rejected with a typed failure instead of a shared-tree run.
UNOWN_WORKTREE_ISOLATION=

# ── Async subagent fleet (terminal agent) ───────────────────────────────────
# Hard wall-clock cap on one async fleet child (task async:true), in ms
# (900000 = 15 min). Also bounds the print-mode drain wait for -p runs.
# Values below 1000 fall back to the default (a typo can never zero it).
UNOWN_FLEET_TIMEOUT_MS=

# ── Project-config trust gate (terminal agent) ──────────────────────────────
# 1/true bypasses approval for project-scoped .unown/mcp.json and
# .unown/lsp.json (CI/headless); unset keeps the gate on — approve with
# /mcp trust (approvals pin path+content fingerprints and re-gate on change).
UNOWN_TRUST_PROJECT_CONFIG=

# unown doctor's unown-state check warns when the project's .unown/ runtime
# state (checkpoints + receipts + reviews) exceeds this, in bytes
# (536870912 = 512 MiB).
UNOWN_STATE_WARN_BYTES=

# ── Cross-project hoist (the user-tier dream path; engine) ──────────────────
# 1 = opt in to the cross-project rule hoist: after a project dream ships,
# the Hoist sub-agent abstracts the few rules that are true for ANY coding
# project and promotes them into the user tier (BOTH targets: the terminal
# ~/.unown/memory/user.md every real session injects AND the engine's
# versioned user tier). Promotion is GATED on cross-project evidence:
# a rule ships only after PI_HOIST_MIN_PROJECTS distinct projects have
# abstracted it (default 2 — one project's dream is project-suspicious;
# the same rule from two projects is a user-level habit). Rules observed
# once park in the engine's candidate ledger. Provenance names the
# observing projects. 1 restores single-observation promotion.
#   PI_USER_TIER_HOIST=1
#   PI_HOIST_MIN_PROJECTS=2

# ── Learning-suite growth (engine) ──────────────────────────────────────────
# Cap on ACTIVE minted tasks before the task-mint job skips authoring new
# curriculum variants (8).
UNOWN_MAX_MINTED_TASKS=

# ── Auto-mode discipline (engine — the detached-engine governor) ────────────
# docs/detached-engine-architecture.md F1/F2/F5/F7. All optional; defaults
# shown. These bound what the engine may do UNATTENDED — the terminal agent
# is never affected by them.
# Job watchdog: any router job exceeding this is aborted, its runs marked
# errored, and the busy mutex released (20 min; floor 60s).
#   PI_JOB_TIMEOUT_MS=1200000
# Dream-check cooldown: at most one dream-check per window, however many
# run:finished events arrive (10 min; 0 = opt out).
#   PI_DREAM_CHECK_COOLDOWN_MS=600000
# Budget governor: learning jobs skip while over ANY ceiling. 0 = unlimited.
#   PI_ENGINE_MAX_CALLS_HOUR=60
#   PI_ENGINE_MAX_TOKENS_HOUR=200000
#   PI_ENGINE_MAX_TOKENS_DAY=2000000
# Upstream circuit breaker: N consecutive engine LLM failures open an
# exponential full-jitter backoff window (30s base, x4 growth, 15 min cap).
#   PI_LLM_BREAKER_THRESHOLD=3
#   PI_LLM_BACKOFF_BASE_MS=30000
# Print-mode stall deadline: an unattended `unown -p` session silent for this
# long force-exits instead of hanging (floor 10s; session events re-arm it).
#   PI_PRINT_STALL_MS=180000
# Hard-exit grace after the final agent turn (answer written → leave):
#   PI_PRINT_EXIT_GRACE_MS=15000
# Piped-stdin idle window: read stdin only while data actively flows; this
# much silence ends the read (listeners detached, stream paused — an open
# idle stdin from a harness/editor is never consumed):
#   PI_PRINT_STDIN_IDLE_MS=500
# Piped-stdin byte cap (an endless pipe stops draining here):
#   PI_PRINT_STDIN_MAX_BYTES=1048576


# ── OS-level sandbox (bubblewrap) ───────────────────────────────────────────
# Runs every engine sandbox command (verify scripts + agent bash-tool calls)
# under bubblewrap: read-only root filesystem, private /home /tmp /run (the
# repo, .env secrets and engine data are invisible), network namespace killed.
# 0 disables OS isolation (falls back to the TypeScript path jail).
UNOWN_OS_SANDBOX=1
# 1 keeps the network namespace shared for sandboxed commands (not
# recommended: sandboxed code could then reach the LLM bridge and the LAN).
UNOWN_SANDBOX_NET=0
# Explicit path to a bwrap binary; defaults to the vendored copy at
# pi-repo/packages/self-learning/native/bin/bwrap, then PATH.
UNOWN_BWRAP=
# Fail-closed sandbox knob (1 or true; the failIfUnavailable analog): engine
# runs REFUSE to start when the OS sandbox is unavailable (bwrap missing or
# broken on Linux, sandbox-exec missing on macOS, or any native-Windows host —
# kernel-grade isolation does not exist there; use WSL2 or unset this) instead
# of degrading to the TypeScript path jail. Unset/0 (default): the documented
# transparent path-jail fallback, unchanged.
UNOWN_SANDBOX_REQUIRED=

# ── Bridge second upstream (optional; llama.cpp / Ollama / LM Studio / any
#    remote OpenAI-compatible endpoint) ───────────────────────────────────────
# The "local lane" is a generic SECOND upstream: requests naming a model in
# BRIDGE_LOCAL_MODELS (or any `local-*` id when the list is empty) are
# routed there instead of the primary upstream — keyless by default, which
# is what a llama.cpp/Ollama/LM Studio server on the loopback wants. A
# REMOTE OpenAI-compatible endpoint works exactly the same way, e.g. a
# vision-capable one:
#   BRIDGE_LOCAL_URL=https://apihub.agnes-ai.com/v1
#   BRIDGE_LOCAL_KEY=cpk-…
#   BRIDGE_LOCAL_MODELS=agnes-3.0-flash
# which is the wiring scripts/agnes_review.mjs uses for VLM design reviews
# of landing-page screenshots. Start a local testbench server with:
#   node benchmarks/local-llm/runner.mjs serve --model qwen3-0.6b
#   (downloads llama.cpp + GGUF on first use)
# The learning layer can then route SELECT subtasks locally (agent sessions
# stay remote — small local models are for auxiliary work, verified in
# benchmarks/local-llm/):
#   PI_MINER_MODEL_ID=local-qwen3-0.6b    failure mining (harness.ts)
#   PI_DREAM_MODEL_ID=local-qwen3-0.6b    AutoDream consolidation (dream.ts)
#   PI_SKILLS_MODEL_ID=local-qwen3-0.6b   skill minting (skills.ts)
#   PI_MINT_MODEL_ID=local-qwen3-0.6b     task minting (mint.ts)
# Task-minting cascade (opt-in; verified E8/H10): draft on the local model
# first (json_schema-grammar-constrained), pay for ONE remote repair call
# only when the draft fails validation — 10.6x cheaper per accepted task at
# equal quality (5 of 6 E8 drafts needed no remote call at all):
#   PI_MINT_CASCADE=1
#   PI_MINT_DRAFT_MODEL_ID=local-qwen3-0.6b
# Unset = the default all-remote topology, unchanged.
BRIDGE_LOCAL_URL=
BRIDGE_LOCAL_KEY=
BRIDGE_LOCAL_MODELS=

# ── Bridge failover upstream (optional; a second REMOTE OpenAI-compatible
#    endpoint — e.g. Agnes AI) ────────────────────────────────────────────────
# The FAILOVER lane — the automatic sibling of the local lane above. Where
# BRIDGE_LOCAL_* ROUTES specific model ids to a second upstream deliberately,
# BRIDGE_FALLBACK_* makes a second endpoint take over when the PRIMARY
# upstream cannot serve: on a failover-eligible primary error the request is
# retried ONCE here, the model rewritten onto BRIDGE_FALLBACK_MODEL, and the
# client sees a normal 200 (or SSE stream) — no error surfaces. Trailing
# slashes on the URL are stripped. Eligible classes: HTTP 429 (Dashscope's
# quota throttle "hour allocated quota exceeded" ships as 429 — measured
# live), 402/408, 401/403 (a rejected/dead primary key IS "primary not
# working"), any 5xx, network failures (incl. Bun's "Unable to connect"
# phrasing), and quota/billing/rate-limit wording in the message (providers
# that ship quota errors as plain 400s). Plain 400/404/409/422 schema/model
# errors do NOT fail over — the same request would fail on the fallback too —
# and local-lane requests never fail over (already a deliberate
# second-endpoint routing choice). Failover cuts in IMMEDIATELY, without
# first burning the primary's 6-attempt retry backoff (~90 s). The fallback
# is a remote endpoint, so it joins the BRIDGE_MIN_SPACING_MS serialized
# spacing throttle and the BRIDGE_UPSTREAM_TIMEOUT_MS headers timeout like
# the primary; its own errors surface honestly (no third-level failover).
# Example wiring (Agnes AI — also accepts image_url inputs):
#   BRIDGE_FALLBACK_URL=https://apihub.agnes-ai.com/v1
#   BRIDGE_FALLBACK_KEY=cpk-…
#   BRIDGE_FALLBACK_MODEL=agnes-3.0-flash
# Observability: GET /health gains a fallback lane {ok, status, url, model}
# (probed when configured, 4 s timeout) plus a `failovers` counter; /v1/log
# and the persistent usage log mark failover-served requests with an `fb:`
# prefix on the upstream model (e.g. fb:agnes-3.0-flash), mirroring the
# `local:` convention; each failover logs a console line. Empty/unset =
# failover OFF (default, previous behavior).
BRIDGE_FALLBACK_URL=
BRIDGE_FALLBACK_KEY=
BRIDGE_FALLBACK_MODEL=

# ── zai-upstream (optional local shim; mini-services/zai-upstream) ──────────
# A zero-config OpenAI-compatible endpoint backed by this sandbox's
# z-ai-web-dev-sdk gateway. scripts/start.ts only launches it when the bridge
# is pointed AT it (BRIDGE_UPSTREAM_URL=http://127.0.0.1:3032/v1); pointing at
# a real provider (Dashscope, OpenAI, ...) never starts it, so leaving these
# unset is the normal production posture.
#   ZAI_UPSTREAM_PORT   listen port (3032)
#   ZAI_UPSTREAM_MODEL  advertised model id (glm-4-plus)
# ZAI_UPSTREAM_PORT=3032
# ZAI_UPSTREAM_MODEL=glm-4-plus

# ── Web search + webfetch (terminal agent; engine sandboxes need NET=1) ─────
# web_search + webfetch ship keyless-first: DuckDuckGo → Tavily (keyless
# mode) → You.com (free MCP) → StackExchange → Wikipedia → HN run out of the
# box (plus npm registry + GitHub repo search, both keyless); any
# provider key below PREPENDS that provider to the chain.
# 0 disables the respective tool.
UNOWN_WEB_SEARCH=
UNOWN_WEBFETCH=
# Explicit provider id or comma-separated chain, e.g. "tavily,duckduckgo".
# Unset = auto (keyed providers first, then the keyless chain).
UNOWN_WEB_SEARCH_PROVIDER=
# Per-provider search timeout, ms (20000) and result cap (8, max 20).
UNOWN_WEB_SEARCH_TIMEOUT_MS=
UNOWN_WEB_SEARCH_MAX_RESULTS=
# webfetch: per-request timeout, ms (30000); returned-character cap
# (20000, clamped 500-200000); robots.txt honoring (0 disables the check).
UNOWN_WEBFETCH_TIMEOUT_MS=
UNOWN_WEBFETCH_MAX_CHARS=
UNOWN_WEBFETCH_ROBOTS=
# SearXNG instance URL (self-host: docker run -d -p 8888:8080 searxng/searxng
# with formats: [html, json] in settings.yml — see scripts/searxng-test/).
UNOWN_SEARXNG_URL=
# Optional StackExchange app key (stackapps.com, free) lifts the keyless
# 300 req/day per-IP limit to 10000/day.
UNOWN_STACKEXCHANGE_KEY=
# 1 = allow webfetch to private/LAN hosts and non-standard ports (advanced:
# internal docs mirrors; the http(s)-only check always applies).
UNOWN_WEBFETCH_ALLOW_PRIVATE=
# ── The web results store (persistent cache behind web_search + webfetch) ──
# One user-scoped store (~/.unown/cache/web) shared across sessions,
# subagents, engine runs and automations: search results TTL-fresh for
# 60 min, fetched pages honor origin Cache-Control (heuristic 30 min,
# capped 24 h) with ETag/Last-Modified revalidation (304 = unchanged), and
# a bounded stale-if-error window serves the last good answer (flagged as
# stale) when every upstream attempt fails. Inspect it: unown webcache
# stats|clear|sweep. All knobs optional — unset = the defaults shown.
# 0 disables the store entirely (every web call goes upstream).
UNOWN_WEB_CACHE=
# Relocate the store (default $UNOWN_HOME/cache/web).
UNOWN_WEB_CACHE_DIR=
# Search freshness, ms (default 3600000 = 60 min).
UNOWN_WEB_SEARCH_CACHE_TTL_MS=
# Fetch heuristic freshness when the origin sends no Cache-Control, ms
# (default 1800000 = 30 min; an origin max-age/Expires wins, capped 24 h).
UNOWN_WEBFETCH_CACHE_TTL_MS=
# Stale-if-error window for search results, ms (default 86400000 = 24 h).
UNOWN_WEB_SEARCH_STALE_MS=
# Stale-if-error window for fetched pages, ms (default 604800000 = 7 d).
UNOWN_WEBFETCH_STALE_MS=
# Byte cap of the store (default 268435456 = 256 MiB, LRU-pruned at it).
UNOWN_WEB_CACHE_MAX_BYTES=
# ── Paid web-search provider keys (any that are set join the chain) ─────────
# Tavily (1000 credits/mo free tier), Brave (api.search.brave.com),
# Serper (Google results), Exa (neural/code search),
# Perplexity (Search API + sonar fallback), Jina (s.jina.ai/r.jina.ai),
# Zhipu Z.AI web_search, Kagi, SerpApi, Firecrawl (search + scrape).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
PERPLEXITY_API_KEY=
JINA_API_KEY=
ZHIPU_API_KEY=
# DashScope enable_search grounding — STANDARD keys only (sk-…).
# Coding-plan keys (sk-sp-…) are refused up front with an actionable note:
# the coding endpoints silently ignore enable_search and the standard
# endpoints reject these keys (verified live 2026-10-19 — the model answers
# from training data and reports no live access). Coding keys remain fine
# for BRIDGE_UPSTREAM_KEY (the chat path); this caveat is search-only.
DASHSCOPE_API_KEY=
KAGI_API_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
# DashScope enable_search grounding overrides (provider "dashscope").
# Base default is the mainland compatible-mode endpoint; intl users set
# https://dashscope-intl.aliyuncs.com/compatible-mode/v1. Ignored for
# coding-plan keys (sk-sp-…), which are refused regardless.
UNOWN_DASHSCOPE_BASE_URL=
UNOWN_DASHSCOPE_MODEL=
# GitHub token (optional) lifts the github provider's 10 req/min search cap.
GITHUB_TOKEN=

# ── Local-ML dream lanes (optional; verified H9-H15, benchmarks/nonllm) ─────
# Fully-local NON-LLM pre-processors around the UNCHANGED AutoDream LLM call.
# Master switch: shadow = compute + report (bus lane:dream events) without
# changing the prompt; 1/live = the lanes alter the dream input. Unset = off,
# prompts byte-identical.
#   PI_NOTE_DEDUP=union      near-dup note collapse (MinHash [+cosine w/ local-ml])
#   PI_MEMORY_RANK=activation no-recency activation ordering (relevance x freq x structure)
#   PI_DREAM_CURATE=hybrid   top-30% full + LexRank-compressed tail (19.9% token cut)
# The optional ONNX embedding sub-package (bge-small q8) lives at
# pi-repo/packages/self-learning/local-ml — NOT installed by default (the
# repo stays native-addon-free); npm install inside it to enable the
# embedding tier. Without it the lanes run symbolic-only.
PI_LOCAL_ML=
PI_NOTE_DEDUP=
PI_MEMORY_RANK=
PI_DREAM_CURATE=
PI_LOCAL_ML_DIR=

# ── Direct provider keys (multi-provider registry) ─────────────────────────
# Optional: keys for direct providers registered with `unown providers add
# --key-env VAR`. Referenced from ~/.unown/agent/models.json as $VAR so the
# secret never lands in a registry file. The engine reads them from this .env
# (via agent:start); terminal sessions read them from your shell.
#   unown providers add --provider agnes --key-env AGNES_API_KEY
#AGNES_API_KEY=
