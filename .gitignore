# Unown — root .gitignore
# Sandbox/template-specific entries are anchored to the repo root (/...) so
# they never swallow pi-repo subdirectories (e.g. packages/*/tests).

# dependencies
node_modules/
.pnp
.pnp.*

# prisma 7 generated client (schema generator output)
src/generated/

# next.js
.next/
/out/
.vercel

# production builds
/build

# env files — configure from .env.example instead
.env
.env.*
!.env.example

# runtime state of the self-learning engine (root only)
/data/
/db/
/.run/

# sandbox / template artifacts (root only)
/.zscripts/
/download/
/upload/
/tool-results/
/examples/
/tests/
/skills/
/Caddyfile
/worklog.md
/dev.log
/server.log

# misc
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local session material (root only)
/.claude
/.z-ai-config
/test
/prompt
/local-*

# typescript
next-env.d.ts
