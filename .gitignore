# Unown — root .gitignore
# Sandbox/template-specific entries are anchored to the repo root (/...) so
# they never swallow pi-repo subdirectories (e.g. packages/*/tests).

# dependencies
node_modules/
.pnp
.pnp.*

# prisma 7 generated client (schema generator output)
src/generated/

# next.js
.next/
/out/
.vercel

# production builds
/build

# env files — configure from .env.example instead
.env
.env.*
!.env.example

# runtime state of the self-learning engine (root only)
/data/
/db/
/.run/

# sandbox / template artifacts (root only)
/.zscripts/
/download/
/upload/
/tool-results/
/examples/
/tests/
/skills/
/Caddyfile
/worklog.md
/dev.log
/server.log

# misc
.DS_Store
*.pem
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local session material (root only)
/.claude
/.z-ai-config
/test
/prompt
/local-*

# typescript
next-env.d.ts

# terminal-agent runtime state (unown setup)
/agent/

# extracted edit-benchmark fixtures (byproduct of the committed tarball)
benchmarks/edit-bench/fixtures/

# coverage report (regenerated by `bun run test:coverage` and by the CI gate)
/coverage.txt

# fresh-rerun scratch bulk (agent workspaces, event dumps) — receipts are the
# per-task JSONL + summaries + official evaluator output
benchmarks/edit-bench/results/rerun-2026-10-17/*/workdirs/
benchmarks/edit-bench/results/rerun-2026-10-17/*/dumps/
benchmarks/edit-bench/results/rerun-2026-10-17/*/events/

# Benchmark runtime scratch (the memory-eval runners' live DBs; receipts are
# the JSONs under benchmarks/memory-eval/results/, not these).
/scratch-mem/
# The engine's runtime tier materialization at the repo root (personal
# user-tier notes land here — runtime state, like scratch-mem; the per-project
# tracked surface is <project>/.unown/memory/project.md, not this).
/memory/

# Session audit ledgers + checkpoint blob stores + review artifacts
# (terminal-agent runtime state: /receipts, /undo, /restore, /review —
# per-machine, per-session, never shared)
.unown/receipts/
.unown/checkpoints/
.unown/reviews/

# local-llm testbench: weights, binaries, and large raw outputs (keep fixtures + curated results)
benchmarks/local-llm/bin/
benchmarks/local-llm/models/
benchmarks/local-llm/results/*/
!benchmarks/local-llm/results/REPORT.md

# nonllm testbench: isolated deps, HF model cache, raw run outputs (keep fixtures + curated REPORT.md)
# (package-lock.json IS committed — it pins onnxruntime-node/transformers.js for reproducible CI)
benchmarks/nonllm/node_modules/
benchmarks/nonllm/models/
benchmarks/nonllm/results/*/
# complementary testbench (campaign 3): weights + raw receipts (keep the curated REPORT.md)
benchmarks/complementary/models/
benchmarks/complementary/results/*/
!benchmarks/complementary/results/REPORT.md
